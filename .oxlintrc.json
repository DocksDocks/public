{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["node_modules/**", "cli/dist/**", "cli/dist-test/**", "cli/src/generated/**"],
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-underscore-dangle": "off",
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ]
  },
  "overrides": [
    {
      "files": ["cli/test/unit/goldenCli.test.ts"],
      "rules": {
        "no-new": "off",
        "no-invalid-regexp": "off"
      }
    }
  ]
}
