prefix_rule(pattern=["docker-compose", "rm"], decision="prompt")
prefix_rule(pattern=["docker-compose", "stop"], decision="prompt")

# `tail -f`/`--follow` never returns and hangs the agent (bare `tail` stays allowed above).
prefix_rule(pattern=["tail", "-f"], decision="prompt")
prefix_rule(pattern=["tail", "--follow"], decision="prompt")
# These commands are prompt or absent, NOT allow, because argv-prefix matching
# cannot gate a later write or exec flag, and allow runs outside the sandbox:
# rg --pre=CMD; sed -n 'e CMD' or -ni; sort -o FILE or --compress-program=CMD;
# the uniq OUTPUT operand; tree -o FILE; git diff/log/show --output=FILE;
# git grep --open-files-in-pager=CMD or -O; git mv into .git/hooks.
# Without a rule, sort, uniq, tree, git diff/log/show, and git grep run in the
# sandbox with no prompt.
prefix_rule(pattern=["rg"], decision="prompt")
prefix_rule(pattern=["sed", "-n"], decision="prompt")
prefix_rule(pattern=["find"], decision="prompt")
prefix_rule(pattern=["sed", "-i"], decision="prompt")
prefix_rule(pattern=["sed", "--in-place"], decision="prompt")
prefix_rule(pattern=["awk"], decision="prompt")
prefix_rule(pattern=["xargs"], decision="prompt")
prefix_rule(pattern=["tee"], decision="prompt")
prefix_rule(pattern=["curl"], decision="prompt")
prefix_rule(pattern=["env"], decision="prompt")

prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["eval"], decision="forbidden")
prefix_rule(pattern=["mkfs"], decision="forbidden")
prefix_rule(pattern=["dd"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force", "origin", "main"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force", "origin", "master"], decision="forbidden")
prefix_rule(pattern=["git", "push", "-f", "origin", "main"], decision="forbidden")
prefix_rule(pattern=["git", "push", "-f", "origin", "master"], decision="forbidden")

# Destructive-command guards. Codex applies the strictest matching rule
# (forbidden > prompt > allow), so an allow rule in another .rules file cannot
# loosen them. The rm, find, git push, git reset, and git clean prompt rules
# above already make every recursive or bulk deletion and every
# history-destroying git command prompt. Codex prefix rules cannot see a
# recursive flag after other flags, so every rm prompts, a single-file rm too.
# A prompt goes to the approvals reviewer in config.toml (auto_review), not
# always to a person.
#
# rm of the filesystem root as Codex runs it: argv tokens, or a plain script
# that Codex splits into argv tokens.
prefix_rule(pattern=["rm", "/"], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=["rm", ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], "/"], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=["rm", ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], "/"], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=["rm", ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], ["-r", "-R", "-f", "-rf", "-fr", "-Rf", "-fR", "-rfv", "-vrf", "-v", "--recursive", "--force", "--no-preserve-root", "--"], "/"], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
# Codex does not split a script that holds ~, $HOME, a glob, or a substitution.
# It matches the whole [shell, -c, script] invocation, so these rules forbid
# only the exact scripts listed.
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm ~", "rm -r ~", "rm -R ~", "rm -f ~", "rm -rf ~", "rm -fr ~", "rm -Rf ~", "rm -fR ~", "rm -r -f ~", "rm -f -r ~", "rm --recursive ~", "rm --recursive --force ~"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm ~/", "rm -r ~/", "rm -R ~/", "rm -f ~/", "rm -rf ~/", "rm -fr ~/", "rm -Rf ~/", "rm -fR ~/", "rm -r -f ~/", "rm -f -r ~/", "rm --recursive ~/", "rm --recursive --force ~/"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm $HOME", "rm -r $HOME", "rm -R $HOME", "rm -f $HOME", "rm -rf $HOME", "rm -fr $HOME", "rm -Rf $HOME", "rm -fR $HOME", "rm -r -f $HOME", "rm -f -r $HOME", "rm --recursive $HOME", "rm --recursive --force $HOME"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm $HOME/", "rm -r $HOME/", "rm -R $HOME/", "rm -f $HOME/", "rm -rf $HOME/", "rm -fr $HOME/", "rm -Rf $HOME/", "rm -fR $HOME/", "rm -r -f $HOME/", "rm -f -r $HOME/", "rm --recursive $HOME/", "rm --recursive --force $HOME/"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"$HOME\"", "rm -r \"$HOME\"", "rm -R \"$HOME\"", "rm -f \"$HOME\"", "rm -rf \"$HOME\"", "rm -fr \"$HOME\"", "rm -Rf \"$HOME\"", "rm -fR \"$HOME\"", "rm -r -f \"$HOME\"", "rm -f -r \"$HOME\"", "rm --recursive \"$HOME\"", "rm --recursive --force \"$HOME\""]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"$HOME/\"", "rm -r \"$HOME/\"", "rm -R \"$HOME/\"", "rm -f \"$HOME/\"", "rm -rf \"$HOME/\"", "rm -fr \"$HOME/\"", "rm -Rf \"$HOME/\"", "rm -fR \"$HOME/\"", "rm -r -f \"$HOME/\"", "rm -f -r \"$HOME/\"", "rm --recursive \"$HOME/\"", "rm --recursive --force \"$HOME/\""]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"$HOME\"/", "rm -r \"$HOME\"/", "rm -R \"$HOME\"/", "rm -f \"$HOME\"/", "rm -rf \"$HOME\"/", "rm -fr \"$HOME\"/", "rm -Rf \"$HOME\"/", "rm -fR \"$HOME\"/", "rm -r -f \"$HOME\"/", "rm -f -r \"$HOME\"/", "rm --recursive \"$HOME\"/", "rm --recursive --force \"$HOME\"/"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm ${HOME}", "rm -r ${HOME}", "rm -R ${HOME}", "rm -f ${HOME}", "rm -rf ${HOME}", "rm -fr ${HOME}", "rm -Rf ${HOME}", "rm -fR ${HOME}", "rm -r -f ${HOME}", "rm -f -r ${HOME}", "rm --recursive ${HOME}", "rm --recursive --force ${HOME}"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm ${HOME}/", "rm -r ${HOME}/", "rm -R ${HOME}/", "rm -f ${HOME}/", "rm -rf ${HOME}/", "rm -fr ${HOME}/", "rm -Rf ${HOME}/", "rm -fR ${HOME}/", "rm -r -f ${HOME}/", "rm -f -r ${HOME}/", "rm --recursive ${HOME}/", "rm --recursive --force ${HOME}/"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"${HOME}\"", "rm -r \"${HOME}\"", "rm -R \"${HOME}\"", "rm -f \"${HOME}\"", "rm -rf \"${HOME}\"", "rm -fr \"${HOME}\"", "rm -Rf \"${HOME}\"", "rm -fR \"${HOME}\"", "rm -r -f \"${HOME}\"", "rm -f -r \"${HOME}\"", "rm --recursive \"${HOME}\"", "rm --recursive --force \"${HOME}\""]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"${HOME}/\"", "rm -r \"${HOME}/\"", "rm -R \"${HOME}/\"", "rm -f \"${HOME}/\"", "rm -rf \"${HOME}/\"", "rm -fr \"${HOME}/\"", "rm -Rf \"${HOME}/\"", "rm -fR \"${HOME}/\"", "rm -r -f \"${HOME}/\"", "rm -f -r \"${HOME}/\"", "rm --recursive \"${HOME}/\"", "rm --recursive --force \"${HOME}/\""]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm \"${HOME}\"/", "rm -r \"${HOME}\"/", "rm -R \"${HOME}\"/", "rm -f \"${HOME}\"/", "rm -rf \"${HOME}\"/", "rm -fr \"${HOME}\"/", "rm -Rf \"${HOME}\"/", "rm -fR \"${HOME}\"/", "rm -r -f \"${HOME}\"/", "rm -f -r \"${HOME}\"/", "rm --recursive \"${HOME}\"/", "rm --recursive --force \"${HOME}\"/"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["rm /*", "rm -r /*", "rm -R /*", "rm -f /*", "rm -rf /*", "rm -fr /*", "rm -Rf /*", "rm -fR /*", "rm -r -f /*", "rm -f -r /*", "rm --recursive /*", "rm --recursive --force /*"]], decision="forbidden", justification="Never remove the home directory or the filesystem root. Move a path to the trash with gio trash -- <path> (Linux) or trash <path> (macOS 15+).")
prefix_rule(pattern=[["bash", "sh", "zsh"], ["-c", "-lc"], ["export HOME=$(mktemp -d)", "export HOME=\"$(mktemp -d)\"", "HOME=$(mktemp -d)", "HOME=\"$(mktemp -d)\""]], decision="forbidden", justification="Never reassign HOME. Each command runs in a new shell, so use literal absolute paths.")

# Forced git removal discards uncommitted changes, and the prefix cannot see a
# later --force, so both commands ask in every form.
prefix_rule(pattern=["git", "rm"], decision="prompt", justification="git rm --force and git worktree remove --force discard uncommitted changes. A prefix rule cannot see a later --force, so every git rm and git worktree remove asks.")
prefix_rule(pattern=["git", "worktree", "remove"], decision="prompt", justification="git rm --force and git worktree remove --force discard uncommitted changes. A prefix rule cannot see a later --force, so every git rm and git worktree remove asks.")

# Moving to the trash. allow runs outside the sandbox, which gio trash and
# trash need to reach the user trash folder. Only the option-terminated
# gio trash -- <path> form is allowed: after --, every argument is a path.
prefix_rule(pattern=["gio", "trash", "--"], decision="allow")
prefix_rule(pattern=["gio", "trash", ["-f", "--force", "--empty", "--restore"]], decision="prompt", justification="Emptying the trash deletes its contents permanently, and --restore --force overwrites the original path. Use gio trash -- <path>.")
prefix_rule(pattern=["trash"], decision="allow")
