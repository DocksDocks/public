{
  "name": "docks-kit",
  "version": "0.22.18",
  "description": "Portable AI coding agent config kit — SoT sync engine + typed CLI for Claude Code, Codex, and universal agent skills",
  "type": "module",
  "license": "MIT",
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DocksDocks/public.git"
  },
  "bin": {
    "docks-kit": "cli/src/main.ts"
  },
  "files": [
    "cli/src",
    "cli/docs",
    "cli/tsconfig.json",
    "docks-kit",
    "docks-kit.ps1",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "bun check --no-script -b -p cli",
    "build:binaries": "bash cli/build-binaries.sh",
    "smoke:native": "bun cli/scripts/native-smoke.ts",
    "smoke:package": "bun cli/scripts/package-smoke.ts",
    "check:generated": "bun cli/scripts/generate-sot-payload.ts --check",
    "prepack": "bun run check:generated",
    "golden:dryrun": "bun cli/test/golden-dryrun.ts",
    "golden:mutation": "bun cli/test/golden-mutation.ts",
    "test:unit": "vitest run",
    "test:runtime:posix": "bun cli/test/statusline-runtime-smoke.mjs posix",
    "test:runtime:windows": "bun cli/test/statusline-runtime-smoke.mjs windows",
    "test:ci": "bun run check:generated && bun run --parallel typecheck test:unit golden:dryrun golden:mutation format:check && bun run test:runtime:posix",
    "test:integration": "bun run --parallel golden:dryrun golden:mutation",
    "test": "bun run --parallel test:unit test:integration",
    "lint": "oxlint",
    "lint:effect": "effect-tsgo diagnostics --project cli/tsconfig.json --strict --format text",
    "format": "bun fmt --no-script cli/src cli/test cli/scripts vitest.config.ts",
    "format:check": "bun fmt --no-script --check cli/src cli/test cli/scripts vitest.config.ts",
    "check": "bun run --parallel lint lint:effect format:check typecheck check:generated test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node-shared": "4.1.2",
    "effect": "4.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.64.1",
    "@types/bun": "1.4.4",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
